{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.gearupquiz.com/:path*",
      "statusCode": 301
    }
  ],
  "crons": [
    {
      "path": "/api/cron-recalculate-averages?part=rank",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-recalculate-averages?part=grade",
      "schedule": "2 0 * * *"
    },
    {
      "path": "/api/cron-recurring-payments",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron-recurring-payments",
      "schedule": "20 1 * * *"
    }
  ]
}
